; Engine configuration file.
; Regenerated by Godot when opened in the editor.

config_version=5

[application]

config/name="angband3d"
config/description="First-person 3D front end for Angband. Phase 1: 2D map client."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="angband3d"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.04, 0.04, 0.05, 1)
