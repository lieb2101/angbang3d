diff --git a/src/main-bridge.c b/src/main-bridge.c
new file mode 100644
index 000000000..ea86bfdb7
--- /dev/null
+++ b/src/main-bridge.c
@@ -0,0 +1,1017 @@
+/**
+ * \file main-bridge.c
+ * \brief JSON state bridge front end, for driving Angband from an external client.
+ *
+ * Copyright (c) 2026 angband3d contributors
+ *
+ * This work is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, version 2.
+ *
+ * This front end renders nothing. It implements a minimal 80x24 Term, and
+ * whenever the game blocks for input it writes one JSON object describing the
+ * whole visible game state to stdout, then reads one command line from stdin.
+ *
+ * Input is delivered as *keypresses* rather than through cmdq_push(), so the
+ * entire existing UI surface -- birth, menus, stores, item prompts, targeting
+ * and wizard mode -- works through the bridge with no special casing.
+ */
+
+#include "angband.h"
+#include "buildid.h"
+#include "cave.h"
+#include "cmd-core.h"
+#include "game-world.h"
+#include "init.h"
+#include "main.h"
+#include "message.h"
+#include "monster.h"
+#include "mon-desc.h"
+#include "obj-desc.h"
+#include "obj-gear.h"
+#include "object.h"
+#include "player.h"
+#include "player-calcs.h"
+#include "player-timed.h"
+#include "player-util.h"
+#include "ui-display.h"
+#include "ui-map.h"
+#include "ui-game.h"
+#include "ui-input.h"
+#include "ui-output.h"
+#include "ui-term.h"
+#include "bridge-json.h"
+#include "z-color.h"
+
+#ifdef USE_BRIDGE
+
+#define BRIDGE_PROTOCOL 1
+
+/* Generous upper bounds; values are clamped rather than trusted. */
+#define BRIDGE_MAX_W 1024
+#define BRIDGE_MAX_H 1024
+#define BRIDGE_MAX_ENTITIES 1024
+#define BRIDGE_MAX_MESSAGES 24
+
+struct bridge_entity {
+	int y, x;
+	int attr;
+	wchar_t glyph;
+	uint32_t idx;
+	const struct object_kind *kind;
+};
+
+typedef struct term_data term_data;
+struct term_data { term t; };
+
+static term_data td;
+
+static unsigned long frame_seq = 0;
+static bool emit_map_data = true;
+
+static struct bridge_entity mon_buf[BRIDGE_MAX_ENTITIES];
+static int mon_count;
+static struct bridge_entity obj_buf[BRIDGE_MAX_ENTITIES];
+static int obj_count;
+
+static const char hex_digits[] = "0123456789abcdef";
+
+
+/**
+ * True once there is a generated level with the player actually placed on it.
+ * Frames can be emitted mid-generation or during level transitions, so this
+ * must be checked before any grid-relative lookup.
+ */
+static bool bridge_in_play(void)
+{
+	return character_dungeon && character_generated && cave && player
+		&& player->upkeep && !player->upkeep->generate_level
+		&& square_in_bounds(cave, player->grid);
+}
+
+static struct object *bridge_get_equipped_by_type(struct player *p, int type)
+{
+	if (!p || !p->body.slots) return NULL;
+	for (int i = 0; i < p->body.count; i++) {
+		if (p->body.slots[i].type == type && p->body.slots[i].obj) {
+			return p->body.slots[i].obj;
+		}
+	}
+	return NULL;
+}
+
+
+/**
+ * ------------------------------------------------------------------------
+ * Frame serialisation
+ * ------------------------------------------------------------------------ */
+
+static void emit_player(FILE *fp)
+{
+	if (!player || !player->upkeep) {
+		fputs("null", fp);
+		return;
+	}
+
+	fputc('{', fp);
+	bj_kv_string(fp, "name", player->full_name);
+	fputc(',', fp);
+	bj_kv_string(fp, "race", player->race ? player->race->name : "");
+	fputc(',', fp);
+	bj_kv_string(fp, "class", player->class ? player->class->name : "");
+	fputc(',', fp);
+	bj_kv_int(fp, "y", player->grid.y);
+	fputc(',', fp);
+	bj_kv_int(fp, "x", player->grid.x);
+	fputc(',', fp);
+	bj_kv_int(fp, "depth", player->depth);
+	fputc(',', fp);
+	bj_kv_int(fp, "max_depth", player->max_depth);
+	fputc(',', fp);
+	bj_kv_int(fp, "level", player->lev);
+	fputc(',', fp);
+	bj_kv_int(fp, "max_lev", player->max_lev);
+	fputc(',', fp);
+	bj_kv_int(fp, "ht", player->ht);
+	fputc(',', fp);
+	bj_kv_int(fp, "wt", player->wt);
+	fputc(',', fp);
+	bj_kv_int(fp, "exp", player->exp);
+	fputc(',', fp);
+	bj_kv_int(fp, "exp_max", player->max_exp);
+	fputc(',', fp);
+	long exp_next = (player->lev >= PY_MAX_LEVEL)
+		? (long)player->exp
+		: (long)(player_exp[player->lev - 1] * player->expfact / 100L);
+	bj_kv_int(fp, "exp_next", exp_next);
+	fputc(',', fp);
+	bj_kv_int(fp, "gold", player->au);
+	fputc(',', fp);
+	bj_kv_int(fp, "hp", player->chp);
+	fputc(',', fp);
+	bj_kv_int(fp, "hp_max", player->mhp);
+	fputc(',', fp);
+	bj_kv_int(fp, "sp", player->csp);
+	fputc(',', fp);
+	bj_kv_int(fp, "sp_max", player->msp);
+	fputc(',', fp);
+	bj_kv_int(fp, "ac", player->known_state.ac + player->known_state.to_a);
+	fputc(',', fp);
+	bj_kv_int(fp, "ac_base", player->known_state.ac);
+	fputc(',', fp);
+	bj_kv_int(fp, "ac_to_a", player->known_state.to_a);
+	fputc(',', fp);
+	bj_kv_int(fp, "study", player->upkeep->new_spells);
+	fputc(',', fp);
+	bj_kv_int(fp, "resting", player_is_resting(player) ? player_resting_count(player) : 0);
+	fputc(',', fp);
+	bj_kv_int(fp, "word_recall", player->word_recall);
+	fputc(',', fp);
+	bj_kv_int(fp, "deep_descent", player->deep_descent);
+	fputc(',', fp);
+	/* Player's own light radius (torch/lantern) - drives client torch. */
+	bj_kv_int(fp, "light", player->state.cur_light);
+	fputc(',', fp);
+	/* Currently equipped light item (if any) */
+	struct object *light_obj = bridge_get_equipped_by_type(player, EQUIP_LIGHT);
+	if (light_obj) {
+		char lbuf[80];
+		object_desc(lbuf, sizeof(lbuf), light_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "light_item", lbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "light_fuel", light_obj->timeout);
+		fputc(',', fp);
+	}
+	/* Currently equipped weapon, bow, and shield items */
+	struct object *weap_obj = bridge_get_equipped_by_type(player, EQUIP_WEAPON);
+	if (weap_obj) {
+		char wbuf[80];
+		object_desc(wbuf, sizeof(wbuf), weap_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "weapon_item", wbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "weapon_tval", weap_obj->tval);
+		fputc(',', fp);
+		bj_kv_int(fp, "weapon_sval", weap_obj->sval);
+		fputc(',', fp);
+	}
+	struct object *bow_obj = bridge_get_equipped_by_type(player, EQUIP_BOW);
+	if (bow_obj) {
+		char bbuf[80];
+		object_desc(bbuf, sizeof(bbuf), bow_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "bow_item", bbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "bow_tval", bow_obj->tval);
+		fputc(',', fp);
+		bj_kv_int(fp, "bow_sval", bow_obj->sval);
+		fputc(',', fp);
+	}
+	struct object *shield_obj = bridge_get_equipped_by_type(player, EQUIP_SHIELD);
+	if (shield_obj) {
+		char shbuf[80];
+		object_desc(shbuf, sizeof(shbuf), shield_obj, ODESC_BASE, player);
+		bj_kv_string(fp, "shield_item", shbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "shield_tval", shield_obj->tval);
+		fputc(',', fp);
+		bj_kv_int(fp, "shield_sval", shield_obj->sval);
+		fputc(',', fp);
+	}
+	/*
+	 * Ambient light of the square the player stands on. Every grid-relative
+	 * lookup must go through bridge_in_play(): during birth and level
+	 * generation `cave` can be stale or only partly built, and reading it
+	 * then kills the process mid-frame.
+	 */
+	bj_kv_int(fp, "grid_light",
+		bridge_in_play() ? square_light(cave, player->grid) : 0);
+	fputc(',', fp);
+	bj_kv_int(fp, "speed", player->state.speed);
+	fputc(',', fp);
+	bj_kv_bool(fp, "dead", player->is_dead);
+	fputc(',', fp);
+	bj_kv_bool(fp, "wizard", player->wizard);
+	fputc(',', fp);
+	/* Non-zero once wizard/debug mode has been used: scores are void. */
+	bj_kv_int(fp, "noscore", player->noscore);
+	fputc(',', fp);
+
+	/* Stats: STR, INT, WIS, DEX, CON */
+	bj_key(fp, "stats");
+	fputc('{', fp);
+	const char *stat_keys[STAT_MAX] = { "str", "int", "wis", "dex", "con" };
+	for (int i = 0; i < STAT_MAX; i++) {
+		if (i) fputc(',', fp);
+		bj_key(fp, stat_keys[i]);
+		fputc('{', fp);
+		bj_kv_int(fp, "use", player->state.stat_use[i]);
+		fputc(',', fp);
+		bj_kv_int(fp, "max", player->stat_max[i]);
+		fputc(',', fp);
+		bj_kv_int(fp, "top", player->state.stat_top[i]);
+		fputc(',', fp);
+		bj_kv_bool(fp, "reduced", player->stat_cur[i] < player->stat_max[i]);
+		fputc('}', fp);
+	}
+	fputc('}', fp);
+	fputc(',', fp);
+
+	/* Active status condition badges */
+	bj_key(fp, "statuses");
+	fputc('[', fp);
+	bool has_stat = false;
+	for (int i = 0; i < TMD_MAX; i++) {
+		if (player->timed[i]) {
+			struct timed_grade *grade = timed_effects[i].grade;
+			while (grade && player->timed[i] > grade->max) {
+				grade = grade->next;
+			}
+			if (!grade || !grade->name || !grade->name[0]) continue;
+			if (has_stat) fputc(',', fp);
+			has_stat = true;
+			fputc('{', fp);
+			bj_kv_string(fp, "name", grade->name);
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", grade->color);
+			fputc(',', fp);
+			bj_kv_int(fp, "val", player->timed[i]);
+			fputc('}', fp);
+		}
+	}
+	if (player->state.speed != 110) {
+		if (has_stat) fputc(',', fp);
+		has_stat = true;
+		fputc('{', fp);
+		char sbuf[32];
+		if (player->state.speed > 110) {
+			snprintf(sbuf, sizeof(sbuf), "Fast (+%d)", player->state.speed - 110);
+			bj_kv_string(fp, "name", sbuf);
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", COLOUR_L_GREEN);
+		} else {
+			snprintf(sbuf, sizeof(sbuf), "Slow (-%d)", 110 - player->state.speed);
+			bj_kv_string(fp, "name", sbuf);
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", COLOUR_L_UMBER);
+		}
+		fputc(',', fp);
+		bj_kv_int(fp, "val", player->state.speed);
+		fputc('}', fp);
+	}
+	if (player_is_resting(player)) {
+		if (has_stat) fputc(',', fp);
+		has_stat = true;
+		fputc('{', fp);
+		char rbuf[32];
+		int n = player_resting_count(player);
+		if (n == REST_ALL_POINTS) snprintf(rbuf, sizeof(rbuf), "Rest (HP/SP)");
+		else if (n == REST_COMPLETE) snprintf(rbuf, sizeof(rbuf), "Rest (Done)");
+		else if (n > 0) snprintf(rbuf, sizeof(rbuf), "Rest (%d)", n);
+		else snprintf(rbuf, sizeof(rbuf), "Rest");
+		bj_kv_string(fp, "name", rbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", COLOUR_L_TEAL);
+		fputc(',', fp);
+		bj_kv_int(fp, "val", n);
+		fputc('}', fp);
+	}
+	if (player->upkeep->new_spells > 0) {
+		if (has_stat) fputc(',', fp);
+		has_stat = true;
+		fputc('{', fp);
+		char stbuf[32];
+		snprintf(stbuf, sizeof(stbuf), "Study (%d)", player->upkeep->new_spells);
+		bj_kv_string(fp, "name", stbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", COLOUR_L_BLUE);
+		fputc(',', fp);
+		bj_kv_int(fp, "val", player->upkeep->new_spells);
+		fputc('}', fp);
+	}
+	if (player->word_recall > 0) {
+		if (has_stat) fputc(',', fp);
+		has_stat = true;
+		fputc('{', fp);
+		char wbuf[32];
+		snprintf(wbuf, sizeof(wbuf), "Recall (%d)", player->word_recall);
+		bj_kv_string(fp, "name", wbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", COLOUR_WHITE);
+		fputc(',', fp);
+		bj_kv_int(fp, "val", player->word_recall);
+		fputc('}', fp);
+	}
+	if (player->deep_descent > 0) {
+		if (has_stat) fputc(',', fp);
+		has_stat = true;
+		fputc('{', fp);
+		char dbuf[32];
+		snprintf(dbuf, sizeof(dbuf), "Descent (%d)", player->deep_descent);
+		bj_kv_string(fp, "name", dbuf);
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", COLOUR_WHITE);
+		fputc(',', fp);
+		bj_kv_int(fp, "val", player->deep_descent);
+		fputc('}', fp);
+	}
+	if (bridge_in_play() && square_isdtrap(cave, player->grid)) {
+		if (has_stat) fputc(',', fp);
+		has_stat = true;
+		fputc('{', fp);
+		bj_kv_string(fp, "name", "DTrap");
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", square_dtrap_edge(cave, player->grid) ? COLOUR_YELLOW : COLOUR_L_GREEN);
+		fputc(',', fp);
+		bj_kv_int(fp, "val", 1);
+		fputc('}', fp);
+	}
+	fputc(']', fp);
+
+	/* Target / Tracked Monster */
+	if (player->upkeep->health_who) {
+		struct monster *mon = player->upkeep->health_who;
+		if (mon && monster_is_visible(mon) && mon->hp >= 0 && !player->timed[TMD_IMAGE]) {
+			fputc(',', fp);
+			bj_key(fp, "target");
+			fputc('{', fp);
+			char mname[80];
+			monster_desc(mname, sizeof(mname), mon, MDESC_STANDARD);
+			bj_kv_string(fp, "name", mname);
+			fputc(',', fp);
+			bj_kv_int(fp, "hp", mon->hp);
+			fputc(',', fp);
+			bj_kv_int(fp, "hp_max", mon->maxhp);
+			fputc(',', fp);
+			bj_kv_int(fp, "pct", (int)(100L * mon->hp / (mon->maxhp ? mon->maxhp : 1)));
+			fputc(',', fp);
+			bj_kv_int(fp, "attr", monster_health_attr());
+			fputc('}', fp);
+		}
+	}
+
+	/* Level Feeling */
+	if (bridge_in_play() && OPT(player, birth_feelings) && player->depth > 0 && cave->feeling_squares >= z_info->feeling_need) {
+		fputc(',', fp);
+		bj_key(fp, "feeling");
+		fputc('{', fp);
+		uint16_t obj_feeling = cave->feeling / 10;
+		uint16_t mon_feeling = cave->feeling - (10 * obj_feeling);
+		bj_kv_int(fp, "obj", obj_feeling);
+		fputc(',', fp);
+		bj_kv_int(fp, "mon", mon_feeling);
+		fputc('}', fp);
+	}
+
+	fputc('}', fp);
+}
+
+
+/**
+ * Write the whole known level.
+ *
+ * Uses map_info()/grid_data_as_text(), the same path Angband's own renderer
+ * takes, so the client sees exactly what the game would draw. Monsters and
+ * objects are harvested during the same pass.
+ */
+static void emit_map(FILE *fp)
+{
+	static wchar_t row_glyph[BRIDGE_MAX_W];
+	static char row_attr[BRIDGE_MAX_W * 2 + 1];
+	static char row_feat[BRIDGE_MAX_W * 2 + 1];
+	static char row_flag[BRIDGE_MAX_W + 1];
+	int h, w, y, x;
+
+	mon_count = 0;
+	obj_count = 0;
+
+	if (!bridge_in_play()) {
+		fputs("null", fp);
+		return;
+	}
+
+	h = cave->height;
+	w = cave->width;
+	if (h < 0) h = 0;
+	if (w < 0) w = 0;
+	if (h > BRIDGE_MAX_H) h = BRIDGE_MAX_H;
+	if (w > BRIDGE_MAX_W) w = BRIDGE_MAX_W;
+
+	fputc('{', fp);
+	bj_kv_int(fp, "h", h);
+	fputc(',', fp);
+	bj_kv_int(fp, "w", w);
+	fputc(',', fp);
+	bj_key(fp, "rows");
+	fputc('[', fp);
+
+	for (y = 0; y < h; y++) {
+		if (y) fputc(',', fp);
+
+		for (x = 0; x < w; x++) {
+			struct grid_data g;
+			struct loc grid = loc(x, y);
+			int a = 0, ta = 0;
+			wchar_t c = L' ', tc = L' ';
+			unsigned flags = 0;
+			unsigned feat;
+
+			memset(&g, 0, sizeof(g));
+			map_info(grid, &g);
+			grid_data_as_text(&g, &a, &c, &ta, &tc);
+
+			if (square_isknown(cave, grid)) flags |= 0x1;
+			if (g.in_view) flags |= 0x2;
+			flags |= ((unsigned)g.lighting & 0x3) << 2;
+
+			feat = (unsigned)g.f_idx & 0xff;
+
+			row_glyph[x] = c;
+			row_attr[x * 2]     = hex_digits[((unsigned)a >> 4) & 0xf];
+			row_attr[x * 2 + 1] = hex_digits[(unsigned)a & 0xf];
+			row_feat[x * 2]     = hex_digits[(feat >> 4) & 0xf];
+			row_feat[x * 2 + 1] = hex_digits[feat & 0xf];
+			row_flag[x]         = hex_digits[flags & 0xf];
+
+			if (g.m_idx > 0 && mon_count < BRIDGE_MAX_ENTITIES) {
+				mon_buf[mon_count].y = y;
+				mon_buf[mon_count].x = x;
+				mon_buf[mon_count].attr = a;
+				mon_buf[mon_count].glyph = c;
+				mon_buf[mon_count].idx = g.m_idx;
+				mon_count++;
+			}
+			if (g.first_kind && obj_count < BRIDGE_MAX_ENTITIES) {
+				obj_buf[obj_count].y = y;
+				obj_buf[obj_count].x = x;
+				obj_buf[obj_count].attr = a;
+				obj_buf[obj_count].glyph = c;
+				obj_buf[obj_count].idx = g.multiple_objects ? 2 : 1;
+				obj_buf[obj_count].kind = g.first_kind;
+				obj_count++;
+			}
+		}
+
+		row_attr[w * 2] = '\0';
+		row_feat[w * 2] = '\0';
+		row_flag[w] = '\0';
+
+		fputc('{', fp);
+		bj_key(fp, "g");
+		bj_wstring(fp, row_glyph, w);
+		fputc(',', fp);
+		bj_kv_string(fp, "a", row_attr);
+		fputc(',', fp);
+		bj_kv_string(fp, "f", row_feat);
+		fputc(',', fp);
+		bj_kv_string(fp, "l", row_flag);
+		fputc('}', fp);
+	}
+
+	fputc(']', fp);
+	fputc('}', fp);
+}
+
+
+static void emit_monsters(FILE *fp)
+{
+	int i;
+
+	fputc('[', fp);
+	for (i = 0; i < mon_count; i++) {
+		struct monster *mon = NULL;
+
+		if (cave && mon_buf[i].idx < (uint32_t)cave->mon_max) {
+			mon = cave_monster(cave, mon_buf[i].idx);
+		}
+
+		if (i) fputc(',', fp);
+		fputc('{', fp);
+		bj_kv_int(fp, "id", mon_buf[i].idx);
+		fputc(',', fp);
+		bj_kv_int(fp, "y", mon_buf[i].y);
+		fputc(',', fp);
+		bj_kv_int(fp, "x", mon_buf[i].x);
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", mon_buf[i].attr);
+		fputc(',', fp);
+		bj_key(fp, "glyph");
+		bj_wstring(fp, &mon_buf[i].glyph, 1);
+
+		if (mon && mon->race) {
+			fputc(',', fp);
+			bj_kv_string(fp, "race", mon->race->name);
+			fputc(',', fp);
+			bj_kv_int(fp, "race_level", mon->race->level);
+			fputc(',', fp);
+			bj_kv_int(fp, "hp", mon->hp);
+			fputc(',', fp);
+			bj_kv_int(fp, "hp_max", mon->maxhp);
+		}
+		fputc('}', fp);
+	}
+	fputc(']', fp);
+}
+
+
+static void emit_objects(FILE *fp)
+{
+	int i;
+
+	fputc('[', fp);
+	for (i = 0; i < obj_count; i++) {
+		if (i) fputc(',', fp);
+		fputc('{', fp);
+		bj_kv_int(fp, "y", obj_buf[i].y);
+		fputc(',', fp);
+		bj_kv_int(fp, "x", obj_buf[i].x);
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", obj_buf[i].attr);
+		fputc(',', fp);
+		bj_key(fp, "glyph");
+		bj_wstring(fp, &obj_buf[i].glyph, 1);
+		fputc(',', fp);
+		bj_kv_bool(fp, "pile", obj_buf[i].idx > 1);
+
+		if (obj_buf[i].kind) {
+			char name[128];
+
+			/*
+			 * easy_know false keeps the flavour for anything the player
+			 * has not identified, so the client cannot spoil the item
+			 * identification game.
+			 */
+			object_kind_name(name, sizeof(name), obj_buf[i].kind, false);
+			fputc(',', fp);
+			bj_kv_string(fp, "name", name);
+		}
+		fputc('}', fp);
+	}
+	fputc(']', fp);
+}
+
+
+/**
+ * The raw 80x24 character grid.
+ *
+ * This carries prompts, menus, stores and the character sheet, which are not
+ * separable from Angband's game logic. The client overlays it as text until
+ * native panels replace each one.
+ */
+static void emit_term(FILE *fp)
+{
+	term *t = Term;
+	int y, x, w, h;
+	static char row_attr[256 * 2 + 1];
+
+	if (!t || !t->scr) {
+		fputs("null", fp);
+		return;
+	}
+
+	w = t->wid;
+	h = t->hgt;
+	if (w < 0) w = 0;
+	if (h < 0) h = 0;
+	if (w > 256) w = 256;
+
+	fputc('{', fp);
+	bj_kv_int(fp, "w", w);
+	fputc(',', fp);
+	bj_kv_int(fp, "h", h);
+	fputc(',', fp);
+	bj_kv_int(fp, "cx", t->scr->cx);
+	fputc(',', fp);
+	bj_kv_int(fp, "cy", t->scr->cy);
+	fputc(',', fp);
+	bj_kv_bool(fp, "cursor", !t->scr->cu && t->scr->cv);
+	fputc(',', fp);
+	bj_key(fp, "rows");
+	fputc('[', fp);
+
+	for (y = 0; y < h; y++) {
+		if (y) fputc(',', fp);
+
+		for (x = 0; x < w; x++) {
+			int a = t->scr->a[y][x];
+			row_attr[x * 2]     = hex_digits[((unsigned)a >> 4) & 0xf];
+			row_attr[x * 2 + 1] = hex_digits[(unsigned)a & 0xf];
+		}
+		row_attr[w * 2] = '\0';
+
+		fputc('{', fp);
+		bj_key(fp, "g");
+		bj_wstring(fp, t->scr->c[y], w);
+		fputc(',', fp);
+		bj_kv_string(fp, "a", row_attr);
+		fputc('}', fp);
+	}
+
+	fputc(']', fp);
+	fputc('}', fp);
+}
+
+
+static void emit_messages(FILE *fp)
+{
+	int n = (int)messages_num();
+	int i;
+
+	if (n > BRIDGE_MAX_MESSAGES) n = BRIDGE_MAX_MESSAGES;
+
+	fputc('[', fp);
+	for (i = n - 1; i >= 0; i--) {
+		const char *s = message_str((uint16_t)i);
+
+		if (i != n - 1) fputc(',', fp);
+		fputc('{', fp);
+		bj_kv_string(fp, "text", s ? s : "");
+		fputc(',', fp);
+		bj_kv_int(fp, "count", message_count((uint16_t)i));
+		fputc(',', fp);
+		bj_kv_int(fp, "attr", message_color((uint16_t)i));
+		fputc('}', fp);
+	}
+	fputc(']', fp);
+}
