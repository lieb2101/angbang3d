diff --git a/src/bridge-json.c b/src/bridge-json.c
new file mode 100644
index 000000000..5bb8ec3ad
--- /dev/null
+++ b/src/bridge-json.c
@@ -0,0 +1,89 @@
+/**
+ * \file bridge-json.c
+ * \brief Minimal JSON output helpers for the "bridge" front end.
+ *
+ * Copyright (c) 2026 angband3d contributors
+ *
+ * This work is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, version 2.
+ */
+
+#include "angband.h"
+#include "bridge-json.h"
+
+void bj_codepoint(FILE *fp, uint32_t cp)
+{
+	switch (cp) {
+	case '"':  fputs("\\\"", fp); return;
+	case '\\': fputs("\\\\", fp); return;
+	case '\b': fputs("\\b", fp); return;
+	case '\f': fputs("\\f", fp); return;
+	case '\n': fputs("\\n", fp); return;
+	case '\r': fputs("\\r", fp); return;
+	case '\t': fputs("\\t", fp); return;
+	default: break;
+	}
+
+	if (cp >= 0x20 && cp < 0x7f) {
+		fputc((int)cp, fp);
+	} else if (cp <= 0xffff) {
+		fprintf(fp, "\\u%04x", (unsigned)cp);
+	} else if (cp <= 0x10ffff) {
+		/* Encode as a UTF-16 surrogate pair. */
+		uint32_t v = cp - 0x10000;
+		fprintf(fp, "\\u%04x\\u%04x",
+			(unsigned)(0xd800 + (v >> 10)),
+			(unsigned)(0xdc00 + (v & 0x3ff)));
+	} else {
+		fputs("\\ufffd", fp);
+	}
+}
+
+void bj_string(FILE *fp, const char *s)
+{
+	fputc('"', fp);
+	if (s) {
+		while (*s) {
+			bj_codepoint(fp, (uint32_t)(unsigned char)*s++);
+		}
+	}
+	fputc('"', fp);
+}
+
+void bj_wstring(FILE *fp, const wchar_t *s, int n)
+{
+	int i;
+
+	fputc('"', fp);
+	if (s) {
+		for (i = 0; i < n; i++) {
+			bj_codepoint(fp, (uint32_t)s[i]);
+		}
+	}
+	fputc('"', fp);
+}
+
+void bj_key(FILE *fp, const char *key)
+{
+	bj_string(fp, key);
+	fputc(':', fp);
+}
+
+void bj_kv_string(FILE *fp, const char *key, const char *value)
+{
+	bj_key(fp, key);
+	bj_string(fp, value);
+}
+
+void bj_kv_int(FILE *fp, const char *key, long value)
+{
+	bj_key(fp, key);
+	fprintf(fp, "%ld", value);
+}
+
+void bj_kv_bool(FILE *fp, const char *key, bool value)
+{
+	bj_key(fp, key);
+	fputs(value ? "true" : "false", fp);
+}
diff --git a/src/bridge-json.h b/src/bridge-json.h
new file mode 100644
index 000000000..e00b887fd
--- /dev/null
+++ b/src/bridge-json.h
@@ -0,0 +1,49 @@
+/**
+ * \file bridge-json.h
+ * \brief Minimal JSON output helpers for the "bridge" front end.
+ *
+ * Copyright (c) 2026 angband3d contributors
+ *
+ * This work is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, version 2.
+ */
+
+#ifndef INCLUDED_BRIDGE_JSON_H
+#define INCLUDED_BRIDGE_JSON_H
+
+#include <stdio.h>
+#include <wchar.h>
+
+/**
+ * Write a JSON string literal, including the surrounding quotes.
+ *
+ * Everything outside printable ASCII is emitted as a \\uXXXX escape, so the
+ * output is valid UTF-8 JSON regardless of the process locale.
+ */
+void bj_string(FILE *fp, const char *s);
+
+/**
+ * As bj_string(), but for a fixed-length wide-character buffer. Values above
+ * the BMP are emitted as surrogate pairs.
+ */
+void bj_wstring(FILE *fp, const wchar_t *s, int n);
+
+/**
+ * Write a single Unicode code point as the body of a JSON string (no quotes).
+ */
+void bj_codepoint(FILE *fp, uint32_t cp);
+
+/** Write "key":"value" */
+void bj_kv_string(FILE *fp, const char *key, const char *value);
+
+/** Write "key":value for a signed integer */
+void bj_kv_int(FILE *fp, const char *key, long value);
+
+/** Write "key":true|false */
+void bj_kv_bool(FILE *fp, const char *key, bool value);
+
+/** Write "key": ready for a caller-supplied raw value */
+void bj_key(FILE *fp, const char *key);
+
+#endif /* INCLUDED_BRIDGE_JSON_H */
