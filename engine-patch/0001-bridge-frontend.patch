+/**
+ * ------------------------------------------------------------------------
+ * Command input
+ * ------------------------------------------------------------------------ */
+
+/**
+ * Translate a key name into a keycode. Returns 0 if unrecognised.
+ */
+static keycode_t bridge_keycode(const char *spec)
+{
+	if (!spec || !*spec) return 0;
+
+	if (streq(spec, "left")) return ARROW_LEFT;
+	if (streq(spec, "right")) return ARROW_RIGHT;
+	if (streq(spec, "up")) return ARROW_UP;
+	if (streq(spec, "down")) return ARROW_DOWN;
+	if (streq(spec, "space")) return ' ';
+	if (streq(spec, "enter")) return KC_ENTER;
+	if (streq(spec, "return")) return KC_ENTER;
+	if (streq(spec, "escape")) return ESCAPE;
+	if (streq(spec, "tab")) return KC_TAB;
+	if (streq(spec, "backspace")) return KC_BACKSPACE;
+	if (streq(spec, "delete")) return KC_DELETE;
+	if (streq(spec, "home")) return KC_HOME;
+	if (streq(spec, "end")) return KC_END;
+
+	if (spec[0] == 'C' && spec[1] == '-' && spec[2]) return KTRL(spec[2]);
+
+	return (keycode_t)(unsigned char)spec[0];
+}
+
+
+/**
+ * Handle one command line. Returns the number of keypresses queued.
+ */
+static int bridge_handle(char *line)
+{
+	char *cmd, *rest;
+
+	cmd = strtok(line, " \t");
+	if (!cmd) return 0;
+	rest = strtok(NULL, "");
+
+	if (streq(cmd, "key")) {
+		keycode_t k = bridge_keycode(rest);
+		if (k) {
+			Term_keypress(k, 0);
+			return 1;
+		}
+		emit_event("error", "bad key");
+		return 0;
+	}
+
+	if (streq(cmd, "keys")) {
+		int n = 0;
+		if (rest) {
+			while (*rest) {
+				Term_keypress((keycode_t)(unsigned char)*rest++, 0);
+				n++;
+			}
+		}
+		return n;
+	}
+
+	if (streq(cmd, "map")) {
+		emit_map_data = !(rest && streq(rest, "off"));
+		emit_event("ok", emit_map_data ? "map on" : "map off");
+		return 0;
+	}
+
+	if (streq(cmd, "frame")) {
+		emit_frame();
+		return 0;
+	}
+
+	if (streq(cmd, "quit")) {
+		emit_event("bye", NULL);
+		quit(NULL);
+		return 0;
+	}
+
+	if (streq(cmd, "ping")) {
+		emit_event("pong", NULL);
+		return 0;
+	}
+
+	if (cmd[0] == '#') return 0;
+
+	emit_event("error", "unknown command");
+	return 0;
+}
+
+
+/**
+ * Emit a frame, then block until the client sends something that produces a
+ * keypress. EOF on stdin ends the game cleanly.
+ */
+static errr bridge_pump(void)
+{
+	char buf[2048];
+
+	emit_frame();
+
+	for (;;) {
+		if (!fgets(buf, sizeof(buf), stdin)) {
+			emit_event("bye", "eof");
+			quit(NULL);
+			return -1;
+		}
+		if (strchr(buf, '\n')) *strchr(buf, '\n') = '\0';
+		if (strchr(buf, '\r')) *strchr(buf, '\r') = '\0';
+
+		if (bridge_handle(buf) > 0) return 0;
+	}
+}
+
+
+/**
+ * ------------------------------------------------------------------------
+ * Term hooks
+ * ------------------------------------------------------------------------ */
+
+static void term_init_bridge(term *t) { }
+static void term_nuke_bridge(term *t) { }
+static errr term_curs_bridge(int x, int y) { return 0; }
+static errr term_wipe_bridge(int x, int y, int n) { return 0; }
+static errr term_text_bridge(int x, int y, int n, int a, const wchar_t *s)
+{
+	return 0;
+}
+
+static errr term_xtra_bridge(int n, int v)
+{
+	switch (n) {
+	case TERM_XTRA_EVENT:
+		/* v is set when the game is genuinely waiting for input. */
+		if (v) return bridge_pump();
+		return 1;
+
+	case TERM_XTRA_FLUSH:
+	case TERM_XTRA_CLEAR:
+	case TERM_XTRA_FRESH:
+	case TERM_XTRA_SHAPE:
+	case TERM_XTRA_ALIVE:
+	case TERM_XTRA_DELAY:
+	case TERM_XTRA_NOISE:
+	case TERM_XTRA_REACT:
+	default:
+		return 0;
+	}
+}
+
+static void term_data_link(int i)
+{
+	term *t = &td.t;
+
+	term_init(t, 80, 24, 256);
+
+	t->init_hook = term_init_bridge;
+	t->nuke_hook = term_nuke_bridge;
+	t->xtra_hook = term_xtra_bridge;
+	t->curs_hook = term_curs_bridge;
+	t->wipe_hook = term_wipe_bridge;
+	t->text_hook = term_text_bridge;
+
+	t->data = &td;
+
+	Term_activate(t);
+
+	angband_term[i] = t;
+}
+
+
+const char help_bridge[] = "JSON state bridge, subopts -nomap";
+
+errr init_bridge(int argc, char *argv[])
+{
+	int i;
+	FILE *fp = stdout;
+
+	for (i = 1; i < argc; i++) {
+		if (streq(argv[i], "-nomap")) {
+			emit_map_data = false;
+			continue;
+		}
+	}
+
+	/*
+	 * main.c only does this under UNIX, and the Windows front end bypasses
+	 * main.c entirely, so on Windows nothing creates the save directory and
+	 * every save fails. Do it here rather than patching main.c, to keep the
+	 * fork rebasable.
+	 */
+	create_needed_dirs();
+
+	term_data_link(0);
+
+	fputc('{', fp);
+	bj_kv_string(fp, "t", "hello");
+	fputc(',', fp);
+	bj_kv_int(fp, "protocol", BRIDGE_PROTOCOL);
+	fputc(',', fp);
+	bj_kv_string(fp, "build", buildid);
+	fputc(',', fp);
+	bj_kv_string(fp, "savefile", savefile);
+	fputc(',', fp);
+	bj_kv_string(fp, "save_dir", ANGBAND_DIR_SAVE ? ANGBAND_DIR_SAVE : "");
+	fputc('}', fp);
+	fputc('\n', fp);
+	fflush(fp);
+
+	return 0;
+}
