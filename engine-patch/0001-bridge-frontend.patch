+
+/**
+ * Input state, so a client knows whether the game wants a normal command or is
+ * showing a menu, store or prompt that only exists on the terminal channel.
+ */
+static void emit_ui(FILE *fp)
+{
+	fputc('{', fp);
+	/* Non-zero when a screen has been pushed: menu, store, character sheet. */
+	bj_kv_int(fp, "overlay", screen_save_depth);
+	fputc(',', fp);
+	/* False when the game is asking a question rather than for a command. */
+	bj_kv_bool(fp, "awaiting_command", inkey_flag);
+	fputc(',', fp);
+	bj_kv_bool(fp, "more", msg_flag);
+	fputc('}', fp);
+}
+
+
+static bool sent_features = false;
+
+/**
+ * The terrain table, sent once. Without it a client has to hard-code feature
+ * indices, which silently rots whenever upstream inserts a terrain type.
+ */
+static void emit_features(void)
+{
+	FILE *fp = stdout;
+	int i;
+
+	if (sent_features || !f_info) return;
+	sent_features = true;
+
+	fputc('{', fp);
+	bj_kv_string(fp, "t", "features");
+	fputc(',', fp);
+	bj_key(fp, "features");
+	fputc('[', fp);
+	for (i = 0; i < FEAT_MAX; i++) {
+		if (i) fputc(',', fp);
+		fputc('{', fp);
+		bj_kv_int(fp, "idx", i);
+		fputc(',', fp);
+		bj_kv_string(fp, "name", f_info[i].name ? f_info[i].name : "");
+		fputc(',', fp);
+		bj_key(fp, "glyph");
+		bj_wstring(fp, &f_info[i].d_char, 1);
+		fputc(',', fp);
+		bj_kv_bool(fp, "passable",
+			tf_has(f_info[i].flags, TF_PASSABLE) ? true : false);
+		fputc('}', fp);
+	}
+	fputc(']', fp);
+	fputc('}', fp);
+	fputc('\n', fp);
+	fflush(fp);
+}
+
+
+static void emit_frame(void)
+{
+	FILE *fp = stdout;
+
+	emit_features();
+
+	fputc('{', fp);
+	bj_kv_string(fp, "t", "frame");
+	fputc(',', fp);
+	bj_kv_int(fp, "seq", (long)++frame_seq);
+	fputc(',', fp);
+	bj_kv_string(fp, "phase", bridge_in_play() ? "play" : "setup");
+	fputc(',', fp);
+
+	bj_key(fp, "ui");
+	emit_ui(fp);
+	fputc(',', fp);
+
+	bj_key(fp, "player");
+	emit_player(fp);
+	fputc(',', fp);
+
+	bj_key(fp, "map");
+	if (emit_map_data) {
+		emit_map(fp);
+	} else {
+		mon_count = obj_count = 0;
+		fputs("null", fp);
+	}
+	fputc(',', fp);
+
+	bj_key(fp, "monsters");
+	emit_monsters(fp);
+	fputc(',', fp);
+
+	bj_key(fp, "objects");
+	emit_objects(fp);
+	fputc(',', fp);
+
+	bj_key(fp, "messages");
+	emit_messages(fp);
+	fputc(',', fp);
+
+	bj_key(fp, "term");
+	emit_term(fp);
+
+	fputc('}', fp);
+	fputc('\n', fp);
+	fflush(fp);
+}
+
+
+static void emit_event(const char *type, const char *detail)
+{
+	FILE *fp = stdout;
+
+	fputc('{', fp);
+	bj_kv_string(fp, "t", type);
+	if (detail) {
+		fputc(',', fp);
+		bj_kv_string(fp, "detail", detail);
+	}
+	fputc('}', fp);
+	fputc('\n', fp);
+	fflush(fp);
+}
